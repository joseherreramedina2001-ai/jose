# Base de datos (requiere PostgreSQL con la extensión pgvector; ver docker-compose.yml)
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/sec_educacion

# Embeddings: "local" usa sentence-transformers (gratis, corre en tu propia máquina)
EMBEDDING_PROVIDER=local

# LLM: "extractive" no llama a ningún proveedor externo (gratis, respuesta ensamblada
# directamente de los fragmentos recuperados). Cambiar a "anthropic" para respuestas
# generativas y completar ANTHROPIC_API_KEY.
LLM_PROVIDER=extractive
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

UPLOAD_DIR=./uploads
CHUNK_SIZE=800
CHUNK_OVERLAP=120
TOP_K=6
SIMILARITY_THRESHOLD=0.35

CORS_ORIGINS=http://localhost:5173
