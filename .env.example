ENVIRONMENT=development

# --- Base de datos ---
# Producción recomendada (con pgvector):
# DATABASE_URL=postgresql+psycopg://usuario:password@localhost:5432/secretaria_educacion
# Desarrollo/pruebas sin infraestructura:
DATABASE_URL=sqlite:///./dev.db
VECTOR_BACKEND=faiss_local
VECTOR_INDEX_PATH=./data/faiss_index

# --- Autenticación ---
SECRET_KEY=CAMBIAR_POR_UNA_CLAVE_ALEATORIA_LARGA
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- IA ---
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=claude-sonnet-4-6
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# --- OCR ---
OCR_ENABLED=true

# --- Archivos ---
MAX_UPLOAD_SIZE_MB=50
UPLOAD_DIR=./data/uploads
